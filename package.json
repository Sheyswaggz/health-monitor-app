{
  "name": "health-monitor-app",
  "version": "1.0.0",
  "description": "Health monitoring application with Express backend and React frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nodemon src/server.js",
    "build": "vite build",
    "start": "node src/server.js",
    "test": "NODE_ENV=test jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "better-sqlite3": "^9.2.2",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "vite": "^5.0.10",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.11",
    "@types/supertest": "^6.0.2"
  },
  "keywords": [
    "health",
    "monitoring",
    "express",
    "react"
  ],
  "author": "",
  "license": "MIT"
}